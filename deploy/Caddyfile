{
  email {$LETSENCRYPT_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy backend:5000
  }

  handle {
    reverse_proxy frontend:80
  }
}

{$ADMIN_DOMAIN} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy backend:5000
  }

  handle {
    reverse_proxy admin:80
  }
}
